# Gnani API (from app.gnani.ai/voice -> API keys)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Speech settings
# STT language and TTS voice come from each kitchen's language (app/languages/*.py).
# STT_LANGUAGE is only the default for `python -m app.gnani`.
STT_LANGUAGE=hi-IN
# transcribe = spoken numbers come back as digits (recommended); verbatim = as spoken
STT_FORMAT=transcribe
TTS_MODEL=timbre-v2.5
TTS_SAMPLE_RATE=24000
# Voice per kitchen language (Timbre catalog). Unset = the default in app/languages/<xx>.py.
# TTS_VOICE_HI=Nalini   TTS_VOICE_EN=Kaveri   TTS_VOICE_KN=Saanvi
TTS_VOICE_ML=Reshma

# App settings
DATABASE_URL=sqlite:///./bacha.db
SAFE_WINDOW_HOURS=4
OFFER_TIMEOUT_SECONDS=20
# Matching: average city speed of a volunteer, and minutes to reach and load
VOLUNTEER_SPEED_KMH=15
PICKUP_BUFFER_MINUTES=10
# NGO needs: match a need only if the food feeds at least this share of its people
NEED_MIN_SHARE=0.5
# Impact numbers: meals per kg (or litre) of food. An assumption, labelled as such;
# plates and boxes are counted one meal each.
MEALS_PER_KG=4

# Dev mode: 1 = canned responses, no credits spent
MOCK_GNANI=1

# 1 = pass every uploaded clip through a phone-line simulation before Prisma
# (8 kHz mono, 300-3400 Hz, G.711 mu-law). The dashboard shows a "Phone line mode" badge.
TELEPHONY_MODE=0

# Optional: folder containing ffmpeg/ffprobe if it is not on PATH
# FFMPEG_DIR=C:/ffmpeg/bin
